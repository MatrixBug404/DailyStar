# =============================================================================
# DailyStar — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in values for your local environment.
# NEVER commit your real .env file — only .env.example is tracked in git.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────

# Environment: local | development | staging | production
NODE_ENV=local

# NestJS backend port
PORT=3001

# Next.js frontend port (used by `next dev`)
NEXT_PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dailystar_dev
POSTGRES_USER=dailystar
POSTGRES_PASSWORD=changeme_local

# Prisma DATABASE_URL (constructed from values above for local dev)
DATABASE_URL=postgresql://dailystar:changeme_local@localhost:5432/dailystar_dev?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for no password in local dev
REDIS_PASSWORD=

REDIS_URL=redis://localhost:6379

# ─── MinIO (local object storage — S3-compatible) ─────────────────────────────

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_local
MINIO_BUCKET_MEDIA=dailystar-media

# S3-compatible endpoint URL (used by the API for signed URLs)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme_local
S3_REGION=us-east-1
S3_BUCKET=dailystar-media

# ─── JWT / Auth (Phase 1 — not used in Phase 0) ───────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_another_random_64_byte_hex_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── API Keys (Phase 9+ — not used until AI newsroom phase) ───────────────────

# Anthropic Claude API key (provider-abstracted behind AIService)
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Allowed origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────

# Log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# ─── MinIO Console ────────────────────────────────────────────────────────────

# Access MinIO web console at http://localhost:9001 with the credentials above
MINIO_CONSOLE_PORT=9001
