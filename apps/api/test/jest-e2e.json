{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "./tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@dailystar/types(.*)$": "<rootDir>/../../packages/types/src$1"
  }
}
